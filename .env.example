# Copy to .env and fill in. NEVER commit .env.

# Alpaca paper trading keys (from app.alpaca.markets -> Paper Trading tab -> API)
ALPACA_KEY=PKXXXXXXXXXXXXXXXXXX
ALPACA_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Paper trading safety net. Set to "false" ONLY when going live, after paper is proven.
PAPER_TRADING=true

# Where generated data lives (bar cache SQLite, journal, logs, backtest CSVs,
# sigengine state). Defaults to /mnt/sandisk/alpaca on this machine. Override
# only if you want data elsewhere. Code + venv + decisions.json stay in the repo.
ALPACA_DATA_DIR=/mnt/sandisk/alpaca

# Optional: override Alpaca base URL (defaults handled by alpaca-py paper flag).
# alpaca-py appends "/v2" itself, so use the base without /v2 (a trailing /v2 is
# stripped automatically by relay/config.py).
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# IBKR (optional, Part 2) — IB Gateway connection for real-time bars via ib_async.
# Port 4002 = Gateway paper, 7497 = TWS paper. Leave commented to use yfinance.
# IBKR_HOST=127.0.0.1
# IBKR_PORT=4002
# IBKR_CLIENT_ID=1

# IB Gateway login (for deploy/run_ibgateway.sh to launch the Gateway headlessly
# via IBC). Either your IBKR PAPER-account or LIVE-account username + password
# — set IBKR_TRADING_MODE to match. Never commit the real values.
# run_ibgateway.sh maps these to IBC's TWSUSERID/TWSPASSWORD.
# TWS_USERID=your-username
# TWS_PASSWORD=your-password
#
# "paper" (default) or "live" — must match which credentials TWS_USERID is.
# UNRELATED to PAPER_TRADING above (that's Alpaca order placement; this is
# the IBKR DATA-ONLY connection, permanently blocked from placing IBKR orders
# by ReadOnlyApi=yes in deploy/ibc.ini regardless of this setting). Some live
# accounts with multiple linked paper sub-accounts fail under "paper" mode
# ("user has multiple Paper Trading users associated with it") and need
# "live" here even if you'd prefer paper — see deploy/ibc.ini's comments.
# IBKR_TRADING_MODE=paper

# DEPRECATED — the relay no longer has an HTTP endpoint (TradingView was removed;
# the signal engine routes orders in-process). Kept only so an existing .env
# doesn't break. Safe to delete.
WEBHOOK_SECRET=change-me-to-a-long-random-string

# Alpaca MCP server (optional) — keys reused for the MCP data tools.
# Same ALPACA_KEY/ALPACA_SECRET above are read by the MCP server config.

# Cloud dashboard publisher (web/publisher.py) — pushes the dashboard's read-only
# data to a Cloudflare R2 bucket for apps/dashboard. Use an R2 API token scoped
# to that ONE bucket with Object Read & Write; never an account-wide token.
# Needed only for real uploads (`--out-dir` works without them).
# The 32-character account id from the Cloudflare dashboard (not a secret).
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=alpaca-dashboard
# A label for this box shown on the cloud page (letters, digits, . _ -); never a hostname.
# PUBLISHER_HOST_LABEL=home
# Public portfolio exporter (web/public_export.py) uses the SAME R2 credentials
# above, so that token must also have Object Read & Write on this bucket (scope
# it to both buckets). It refuses to write to R2_BUCKET. docs/public-portfolio.md.
# R2_PUBLIC_BUCKET=alpaca-public
