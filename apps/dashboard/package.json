{
	"name": "alpaca-dashboard",
	"private": true,
	"version": "0.0.0",
	"description": "Cloud dashboard for the Alpaca trading system: a React SPA and one Cloudflare Worker reading a push-only R2 snapshot.",
	"type": "module",
	"packageManager": "pnpm@12.23.0+sha512.02da94ffaf133f46074322afe552f90d40b5f71ae259aefbccdacc5085b1d617e98d65e0131f5748b9b67445978ee5055d7d59a473f1eef0d504854fefcd5975",
	"engines": {
		"node": ">=22.22.0"
	},
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"preview": "pnpm run build && vite preview",
		"lint": "oxlint --deny-warnings",
		"typecheck": "tsc -b",
		"test": "vitest run",
		"test:watch": "vitest",
		"cf-typegen": "wrangler types worker-configuration.d.ts --strict-vars=false --env-file=/dev/null",
		"cf-typegen:check": "wrangler types worker-configuration.d.ts --strict-vars=false --env-file=/dev/null --check",
		"seed:local": "node scripts/seed-local-r2.mjs"
	},
	"dependencies": {
		"@tanstack/react-query": "^5.108.4",
		"jose": "^6.2.18",
		"lightweight-charts": "^5.3.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-router": "^8.5.3"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.70.1",
		"@tailwindcss/vite": "^4.3.5",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/jest-dom": "^8.0.0",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.13",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"jsdom": "^31.0.1",
		"oxlint": "^1.90.0",
		"tailwindcss": "^4.3.5",
		"typescript": "~7.0.2",
		"vite": "^8.3.6",
		"vitest": "^5.1.1",
		"wrangler": "^4.168.0"
	}
}
