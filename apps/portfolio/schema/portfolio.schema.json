{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Public portfolio (portfolio.json)",
  "description": "The ONE object the home box publishes for the public portfolio site (web/public_export.py writes it; apps/portfolio reads it). It is the leak gate: every object below sets additionalProperties:false, so a field nobody whitelisted cannot ship. The exporter validates against this file before every upload and CI validates the fixture. Conventions: every *_pct, win_rate, stop_pct, deploy, suggested_size and daily_loss_limit is a FRACTION (0.0123 = 1.23%); money is USD; timestamps are UTC (YYYY-MM-DDTHH:MM:SSZ); dates are US/Eastern session dates. Owner decisions encoded here, for this file only: only the owner's own account values, own fill prices and the levels the system set itself (stop fractions, standing-order levels, put strikes), daily equity only (no intraday series) and none from a session still in progress, no third-party market data (no candles, bars, current/last prices or market values), no model-written text (no research notes, contingency reasons or recap titles), no ids, paths, host names, logs, presenter data, desk digest or zh cut, and only recaps whose recorded YouTube privacy is public. The recap videos themselves are not covered: a language model writes their scripts and titles, and most of them show the live dashboard, market candles and current prices included. This file lists each one by date, video id and length only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "account", "positions", "trades", "signals", "strategy", "recaps"],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "as_of", "data_delay", "generated_by", "unavailable"],
      "properties": {
        "schema": {"const": 1},
        "as_of": {"$ref": "#/$defs/timestamp"},
        "data_delay": {"$ref": "#/$defs/note"},
        "generated_by": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^public_export/[0-9]{1,4}\\.[0-9]{1,4}\\.[0-9]{1,4}(\\+g[0-9a-f]{4,40})?$"
        },
        "unavailable": {
          "description": "Sections whose source failed this run; each is null (options: positions.options is null) instead of stale or partial data.",
          "type": "array",
          "maxItems": 7,
          "uniqueItems": true,
          "items": {"enum": ["account", "positions", "options", "trades", "signals", "strategy", "recaps"]}
        }
      }
    },
    "account": {
      "anyOf": [{"type": "null"}, {"$ref": "#/$defs/account"}]
    },
    "positions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["equities", "options"],
      "properties": {
        "equities": {
          "anyOf": [
            {"type": "null"},
            {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/position"}}
          ]
        },
        "options": {
          "anyOf": [
            {"type": "null"},
            {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/option"}}
          ]
        }
      }
    },
    "trades": {
      "anyOf": [{"type": "null"}, {"$ref": "#/$defs/trades"}]
    },
    "signals": {
      "anyOf": [{"type": "null"}, {"$ref": "#/$defs/signals"}]
    },
    "strategy": {
      "anyOf": [{"type": "null"}, {"$ref": "#/$defs/strategy"}]
    },
    "recaps": {
      "anyOf": [
        {"type": "null"},
        {"type": "array", "maxItems": 12, "items": {"$ref": "#/$defs/recap"}}
      ]
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "symbol": {
      "type": "string",
      "maxLength": 31,
      "pattern": "^[A-Z0-9]{1,15}([/.-][A-Z0-9]{1,15})?$"
    },
    "note": {
      "type": "string",
      "maxLength": 300,
      "pattern": "^[^\\u0000-\\u001F\\u007F]*$"
    },
    "money": {
      "description": "USD, own account values only.",
      "type": "number",
      "minimum": -1000000000,
      "maximum": 1000000000
    },
    "fill_price": {
      "description": "A price the account itself filled at (or an average of its own fills). Never a quote.",
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 10000000
    },
    "quantity": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1000000000
    },
    "ratio": {
      "description": "A fraction: 0.0123 = 1.23%.",
      "type": "number",
      "minimum": -1000,
      "maximum": 1000
    },
    "unit_fraction": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "strategy_param": {
      "type": "number",
      "minimum": 0,
      "maximum": 100000
    },
    "day_return": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "return_pct"],
      "properties": {
        "date": {"$ref": "#/$defs/date"},
        "return_pct": {"$ref": "#/$defs/ratio"}
      }
    },
    "account": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paper", "start_date", "start_equity", "equity", "day_pl_pct", "total_return_pct",
        "max_drawdown_pct", "best_day", "worst_day", "daily"
      ],
      "properties": {
        "paper": {"type": "boolean"},
        "start_date": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/date"}]},
        "start_equity": {
          "description": "Closing equity of the first completed session (the first point of daily).",
          "anyOf": [{"type": "null"}, {"$ref": "#/$defs/money"}]
        },
        "equity": {
          "description": "Equity at the end of the last COMPLETED session (the last point of daily), never the current equity: with a position's qty and avg_entry_price, the current equity would give back that symbol's live price.",
          "$ref": "#/$defs/money"
        },
        "day_pl_pct": {
          "description": "The last completed session's change against the session before it (null across a hole in the history), never the broker's day P&L, which would give back the move since the last close.",
          "anyOf": [{"type": "null"}, {"$ref": "#/$defs/ratio"}]
        },
        "total_return_pct": {
          "description": "equity over start_equity, less 1: both are closing equities of completed sessions (the last and the first point of daily).",
          "anyOf": [{"type": "null"}, {"$ref": "#/$defs/ratio"}]
        },
        "max_drawdown_pct": {
          "description": "Peak-to-trough on the daily curve (completed sessions only); 0 or negative.",
          "anyOf": [{"type": "null"}, {"type": "number", "minimum": -1, "maximum": 0}]
        },
        "best_day": {
          "description": "The largest one-session change, each session against the session before it on the exchange calendar; a session missing from the broker's history is skipped, not folded into the next.",
          "anyOf": [{"type": "null"}, {"$ref": "#/$defs/day_return"}]
        },
        "worst_day": {
          "description": "As best_day, the smallest.",
          "anyOf": [{"type": "null"}, {"$ref": "#/$defs/day_return"}]
        },
        "daily": {
          "description": "DAILY EQUITY ONLY (owner decision: no intraday series). One closing equity per COMPLETED session since the account started, oldest first; nothing from a session still in progress.",
          "type": "array",
          "maxItems": 5000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["date", "equity"],
            "properties": {
              "date": {"$ref": "#/$defs/date"},
              "equity": {"$ref": "#/$defs/money"}
            }
          }
        }
      }
    },
    "position": {
      "description": "An open share/crypto position: the own average fill and the stop rule only. No current price, no market value, and no unrealized P&L or distance to the stop, because each of those is computed from the broker's current price and, with the entry price, gives it back.",
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol", "side", "qty", "avg_entry_price", "stop_pct"],
      "properties": {
        "symbol": {"$ref": "#/$defs/symbol"},
        "side": {"enum": ["long", "short"]},
        "qty": {"$ref": "#/$defs/quantity"},
        "avg_entry_price": {"$ref": "#/$defs/fill_price"},
        "stop_pct": {
          "description": "The symbol's stop, published only where the site can vouch for it: a long the engine itself opened (its entry sidecar says so) in an enabled symbol, never shares the put sleeve was assigned. The engine sells when a bar closes at or below the entry of a strategy's own simulated trade (the close of its buy-signal bar) less this fraction, so the real level is measured from that entry, not from avg_entry_price. It is a check on closed bars, not an order at the broker, so an exit can land well past it. Null is not proof that no stop exists: a strategy that is long in its own simulation can also stop out a position the engine did not open. Nor is a value proof that one is checked: when a strategy's simulation enters and stops out on the same bar, the engine handles that stop before the real buy, and the position it opens can be left with no stop.",
          "anyOf": [{"type": "null"}, {"$ref": "#/$defs/unit_fraction"}]
        }
      }
    },
    "option": {
      "description": "An open option in the put sleeve. No option quote, no mark, no market value.",
      "type": "object",
      "additionalProperties": false,
      "required": ["underlying", "type", "side", "strike", "expiry", "qty", "premium_received"],
      "properties": {
        "underlying": {"$ref": "#/$defs/symbol"},
        "type": {"enum": ["put", "call"]},
        "side": {"enum": ["short"]},
        "strike": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/fill_price"}]},
        "expiry": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/date"}]},
        "qty": {"$ref": "#/$defs/quantity"},
        "premium_received": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/money"}]}
      }
    },
    "trades": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stats", "round_trips"],
      "properties": {
        "stats": {
          "description": "Over the closed share/crypto round trips (the option sleeve is not included).",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "round_trips", "wins", "losses", "win_rate", "avg_win", "avg_loss", "avg_win_pct",
            "avg_loss_pct", "profit_factor", "realized_pnl"
          ],
          "properties": {
            "round_trips": {"type": "integer", "minimum": 0, "maximum": 1000000},
            "wins": {"type": "integer", "minimum": 0, "maximum": 1000000},
            "losses": {"type": "integer", "minimum": 0, "maximum": 1000000},
            "win_rate": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/unit_fraction"}]},
            "avg_win": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/money"}]},
            "avg_loss": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/money"}]},
            "avg_win_pct": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/ratio"}]},
            "avg_loss_pct": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/ratio"}]},
            "profit_factor": {
              "description": "Gross profit / gross loss; null when there is no losing trip.",
              "anyOf": [{"type": "null"}, {"type": "number", "minimum": 0, "maximum": 1000000}]
            },
            "realized_pnl": {"$ref": "#/$defs/money"}
          }
        },
        "round_trips": {
          "description": "Closed round trips (flat -> flat), newest exit first.",
          "type": "array",
          "maxItems": 500,
          "items": {"$ref": "#/$defs/round_trip"}
        }
      }
    },
    "round_trip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbol", "side", "qty", "entry_price", "exit_price", "entry_at", "exit_at", "pnl",
        "pnl_pct", "strategy"
      ],
      "properties": {
        "symbol": {"$ref": "#/$defs/symbol"},
        "side": {"enum": ["long"]},
        "qty": {"$ref": "#/$defs/quantity"},
        "entry_price": {"$ref": "#/$defs/fill_price"},
        "exit_price": {"$ref": "#/$defs/fill_price"},
        "entry_at": {"$ref": "#/$defs/timestamp"},
        "exit_at": {"$ref": "#/$defs/timestamp"},
        "pnl": {"$ref": "#/$defs/money"},
        "pnl_pct": {"$ref": "#/$defs/ratio"},
        "strategy": {
          "description": "The strategy that opened the trip, when the engine recorded it; null otherwise.",
          "anyOf": [{"type": "null"}, {"enum": ["ema", "bollinger_rsi", "macd_sma"]}]
        }
      }
    },
    "signals": {
      "description": "The research board: bias, priority and suggested size per watched symbol. No research notes and no contingency reasons.",
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "rows"],
      "properties": {
        "date": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/date"}]},
        "rows": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["symbol", "bias", "priority", "suggested_size", "contingencies"],
            "properties": {
              "symbol": {"$ref": "#/$defs/symbol"},
              "bias": {"anyOf": [{"type": "null"}, {"enum": ["long", "flat", "short"]}]},
              "priority": {"anyOf": [{"type": "null"}, {"type": "integer", "minimum": -1000, "maximum": 1000}]},
              "suggested_size": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/unit_fraction"}]},
              "contingencies": {
                "type": "array",
                "maxItems": 10,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["condition", "level", "valid_until"],
                  "properties": {
                    "condition": {"enum": ["close_above", "close_below"]},
                    "level": {
                      "description": "The research's own trigger level (decisions.json), not a market quote.",
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 10000000
                    },
                    "valid_until": {"$ref": "#/$defs/timestamp"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbols", "risk"],
      "properties": {
        "symbols": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["symbol", "enabled", "on_watchlist", "interval", "stop_pct", "deploy", "strategies"],
            "properties": {
              "symbol": {"$ref": "#/$defs/symbol"},
              "enabled": {"type": "boolean"},
              "on_watchlist": {
                "description": "Whether research's watchlist lists the symbol. The risk gate refuses every buy (crypto included) for a symbol that is not on it; null when research declares no watchlist, so the gate refuses none.",
                "anyOf": [{"type": "null"}, {"type": "boolean"}]
              },
              "interval": {
                "anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9]{1,3}(m|h|d|wk|mo)$"}]
              },
              "stop_pct": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/unit_fraction"}]},
              "deploy": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/unit_fraction"}]},
              "strategies": {
                "description": "One entry per strategy the engine runs on the symbol; the types are exactly backtest/multi_strategy.py STRATEGY_RUNNERS.",
                "type": "array",
                "maxItems": 10,
                "items": {
                  "oneOf": [
                    {"$ref": "#/$defs/strategy_ema"},
                    {"$ref": "#/$defs/strategy_bollinger_rsi"},
                    {"$ref": "#/$defs/strategy_macd_sma"}
                  ]
                }
              }
            }
          }
        },
        "risk": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "daily_loss_limit", "daily_loss_hard_cap", "max_position_shares_cap",
            "allow_extended_hours", "sleeve_reserve_pct"
          ],
          "properties": {
            "daily_loss_limit": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/unit_fraction"}]},
            "daily_loss_hard_cap": {"$ref": "#/$defs/unit_fraction"},
            "max_position_shares_cap": {"type": "number", "minimum": 0, "maximum": 1000000000},
            "allow_extended_hours": {
              "description": "Whether the risk gate lets a BUY go out outside the regular session, read as the gate reads it (a missing key is false).",
              "type": "boolean"
            },
            "sleeve_reserve_pct": {
              "description": "The share of equity the options sleeve keeps for itself (0 when the sleeve is off). A buy is sized as deploy x (equity less this reserve).",
              "$ref": "#/$defs/unit_fraction"
            }
          }
        }
      }
    },
    "strategy_ema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"const": "ema"},
        "fast": {"$ref": "#/$defs/strategy_param"},
        "slow": {"$ref": "#/$defs/strategy_param"},
        "window": {"$ref": "#/$defs/strategy_param"}
      }
    },
    "strategy_bollinger_rsi": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"const": "bollinger_rsi"},
        "rsi_length": {"$ref": "#/$defs/strategy_param"},
        "bb_length": {"$ref": "#/$defs/strategy_param"},
        "bb_mult": {"$ref": "#/$defs/strategy_param"}
      }
    },
    "strategy_macd_sma": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"const": "macd_sma"},
        "fast_len": {"$ref": "#/$defs/strategy_param"},
        "slow_len": {"$ref": "#/$defs/strategy_param"},
        "signal_len": {"$ref": "#/$defs/strategy_param"},
        "veryslow_len": {"$ref": "#/$defs/strategy_param"}
      }
    },
    "recap": {
      "description": "An English recap edition published on YouTube with recorded privacy 'public': its session date, video id and length. Nothing else from the edition's meta.json, so no title (a language model writes it; the site labels each video by its date).",
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "youtube_id", "duration_s"],
      "properties": {
        "date": {"$ref": "#/$defs/date"},
        "youtube_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{11}$"},
        "duration_s": {"anyOf": [{"type": "null"}, {"type": "number", "minimum": 0, "maximum": 36000}]}
      }
    }
  }
}
