# Secrets — never commit
.env
# Credential BACKUPS. switch_account.py writes .env.bak-<stamp> when the book is
# pointed at a different Alpaca account, and that file holds the PREVIOUS
# account's live secret. `.env` alone does not match it, so without this line a
# routine `git add -A` commits a secret.
.env.bak-*
.env.*.bak
# Every other .env variant too (.env.local, .env.production, ...): any of them
# can hold a key. The template is the only one that is tracked.
.env.*
!.env.example
*.key
*.pem

# YouTube OAuth client secret + refresh token (full channel access — treat as a password)
briefing/.youtube/

# Claude decision outputs that may contain personal strategy notes
decisions/*.local
decisions/decisions.json

# Agent-written inputs, regenerated every run — derived data, not history.
# recap_/weekend_ are the COSMETIC source for one edition's video (the rendered
# edition and its meta.json are kept in the archive on /mnt/sandisk); _prices_ is
# the price sheet agent/prices.py writes just before each research run. Tracking
# them would mean a commit per cron firing, and one careless `git add .` away
# from publishing a day's trade research.
decisions/recap_*.json
decisions/weekend_*.json
# Everything underscore-prefixed here is derived, same convention the archive
# uses for `_`-prefixed slot dirs: _prices_ is the sheet agent/prices.py writes
# before each run, and _midday_/_preclose_ are decision snapshots recovered out
# of agent/research_intraday.log to re-render a lost edition.
decisions/_*.json

# Regenerated before every research run (agent/live_state.py) — derived data
agent/live_state.json

# Worktrees created by the Claude Code harness
.claude/worktrees/

# Trade journal / logs
*.jsonl
logs/
*.log

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.envrc
.pytest_cache/

# vectorbt / data caches
*.h5
*.parquet
data_cache/

# IDE
.idea/
.vscode/

# OS
.DS_Store

# Rendered research briefing videos (regenerated by briefing/generate.py)
briefing/.hf_work/
briefing/briefing.log
web/static/media/*
!web/static/media/.gitkeep

# Lip-sync probe scratch renders
briefing/.probe/

# ---------------------------------------------------------------------------
# LOCAL-ONLY BY DESIGN. This repository is the publishable copy of the system;
# the working install keeps these files on disk, and they must never be pushed.

# Presenter assets are local-only: the locked plates, the voice clips and the
# persona file. The renderer reads them from disk; none of it belongs on a
# remote.
briefing/assets/host2/
briefing/host2.json

# Retired presenter files (not in this repository). The working install may
# still hold them on disk; nothing reads them, and they must not come back.
briefing/host.json
briefing/assets/host/

# Personal trading research and notes: reports, P&L, account details, and the
# hand-written operator notes the research crons read. decisions/csp.json is
# config the code reads and stays tracked.
decisions/*.md
decisions/*.corrupt-*
agent/lessons.md
cron/backups/

# Per-machine Claude Code permissions file (rewritten on every approval)
.claude/settings.local.json
*.doctor-backup

# Editor and merge leftovers
*.bak
*.orig

/.venv

# Node / Vite
node_modules/
dist/
.wrangler/
.dev.vars*
!.dev.vars.example

# Presenter design notes are local-only, like the assets they describe.
briefing/HOST2.md
briefing/HOST2_PRODUCTION_PARITY.md
